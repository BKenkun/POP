rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'maryandpopper@gmail.com',
        'enriqueespincosme@gmail.com',
        'EnriqueEspinCosme@gmail.com'
      ];
    }

    // Public catalogue; only administrators can change prices or stock.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Customers may read coupon details to validate a code in the UI.
    // Coupon creation, configuration and usage counters are server/admin-only.
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // A new account may only initialize its own profile with zero privileges/points.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'creationTime', 'createdAt',
          'loyaltyPoints', 'isSubscribed', 'addresses'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('loyaltyPoints', 0) == 0
        && request.resource.data.get('isSubscribed', false) == false;

      // A customer may edit addresses/display name, never points or subscription flags.
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['addresses', 'displayName'])
      );

      // Account deletion must be handled through a trusted server workflow.
      allow delete: if isAdmin();

      match /shoppingCarts/{cartId} {
        allow read, write: if isOwner(userId);
      }

      match /orders/{orderId} {
        // Customers can see their own orders. All order mutations are server/admin-only.
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // Admin order dashboards use collectionGroup('orders').
    match /{path=**}/orders/{orderId} {
      allow get, list: if isAdmin();
    }

    // Server-only rate-limit counters and webhook audit records.
    match /securityRateLimits/{documentId} {
      allow read, write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // No client access to private application configuration.
    match /appSettings/{documentId} {
      allow read, write: if false;
    }
  }
}
